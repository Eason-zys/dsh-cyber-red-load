{
  "name": "dsh-cyber-red-load",
  "version": "0.1.0",
  "description": "常驻「算力负载」四档滑动条：把模型弹层里的推理等级搬到输入框底部，沿用 cyber-red-ui 的红黑配色。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Eason-zys",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "cyber-red"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eason-zys/dsh-cyber-red-load.git"
  },
  "homepage": "https://github.com/Eason-zys/dsh-cyber-red-load#readme",
  "bugs": {
    "url": "https://github.com/Eason-zys/dsh-cyber-red-load/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
